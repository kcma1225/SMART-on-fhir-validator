      "flowStep": "smart_metadata",
      "results": [
        { "field": "grant_types_supported",            "status": "PASS" },
        { "field": "token_endpoint",                   "status": "PASS" },
        { "field": "authorization_endpoint",           "status": "PASS" },
        { "field": "capabilities",                     "status": "PASS" },
        { "field": "code_challenge_methods_supported", "status": "PASS" }
      ]
    }
  },
  {
    "id": "test-010",
    "standard": "SMART",
    "description": "SMART Metadata — 缺少 capabilities (conditional → SKIP)",
    "input": {
      "institution_id": 3,
      "req_method": "GET",
