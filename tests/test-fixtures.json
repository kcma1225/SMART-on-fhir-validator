      "res_body": "{\"grant_types_supported\":[\"authorization_code\"],\"token_endpoint\":\"https://auth.example.com/token\",\"authorization_endpoint\":\"https://auth.example.com/auth\",\"capabilities\":[\"launch-standalone\"],\"code_challenge_methods_supported\":[\"S256\"]}"
