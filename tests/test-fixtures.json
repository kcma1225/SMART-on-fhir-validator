  {
    "id": "test-013",
    "standard": "SMART",
    "description": "FHIR Request — Authorization 存在但非 Bearer 格式",
    "input": {
      "institution_id": 4,
      "req_method": "GET",
      "req_url": "https://fhir.example.com/fhir/Patient/123",
      "req_headers": { "Authorization": "Basic dXNlcjpwYXNz" },
      "req_body": null,
      "res_body": null
    },
    "expected": {
      "flowStep": "fhir_request",
      "results": [
        { "field": "Authorization", "status": "FAIL", "detail": "header present but does not match pattern ^Bearer .+" }
