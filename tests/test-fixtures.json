  {
    "id": "test-001",
    "standard": "SMART",
    "description": "Authorization Request — 所有 Required 欄位齊全",
    "input": {
      "institution_id": 1,
      "req_method": "GET",
      "req_url": "https://auth.example.com/protocol/openid-connect/auth?response_type=code&client_id=myapp&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcb&scope=openid&state=abc123&aud=https%3A%2F%2Fresource.example.com&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK&code_challenge_method=S256",
      "req_headers": {},
      "req_body": null,
      "res_body": null
    },
    "expected": {
      "flowStep": "authorization_request",
      "results": [
        { "field": "response_type",         "status": "PASS" },
        { "field": "client_id",             "status": "PASS" },
        { "field": "redirect_uri",          "status": "PASS" },
        { "field": "scope",                 "status": "PASS" },
        { "field": "state",                 "status": "PASS" },
        { "field": "aud",                   "status": "PASS" },
        { "field": "code_challenge",        "status": "PASS" },
        { "field": "code_challenge_method", "status": "PASS" },
        { "field": "launch",                "status": "SKIP" }
      ]
    }
  },
