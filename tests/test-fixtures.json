    "input": {
      "institution_id": 1,
      "req_method": "GET",
      "req_url": "https://auth.example.com/realms/IUA/protocol/openid-connect/auth?response_type=code&client_id=iua-fhir&state=abc123&code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK&code_challenge_method=S256&redirect_uri=https%3A%2F%2Fclient.example.com%2Fcb&scope=openid&resource=https%3A%2F%2Ffhir.example.com",
      "req_headers": {},
      "req_body": null,
      "res_body": null
    },
    "expected": {
      "flowStep": "authorization_request",
      "results": [
        { "field": "response_type",         "status": "PASS" },
        { "field": "client_id",             "status": "PASS" },
        { "field": "state",                 "status": "PASS" },
        { "field": "code_challenge",        "status": "PASS" },
        { "field": "redirect_uri",          "status": "PASS" },
        { "field": "scope",                 "status": "PASS" },
        { "field": "code_challenge_method", "status": "PASS" },
        { "field": "resource",              "status": "PASS" }
      ]
    }
  },
  {
    "id": "iua-002",
    "standard": "IUA",
    "description": "IUA Authorization Request — response_type 非 code (pattern fail) 且缺 code_challenge",
    "input": {
      "institution_id": 1,
      "req_method": "GET",
      "req_url": "https://auth.example.com/realms/IUA/protocol/openid-connect/auth?response_type=token&client_id=iua-fhir&state=abc123",
      "req_headers": {},
      "req_body": null,
      "res_body": null
    },
    "expected": {
      "flowStep": "authorization_request",
      "results": [
        { "field": "response_type",  "status": "FAIL", "detail": "value does not match pattern ^code$" },
        { "field": "client_id",      "status": "PASS" },
        { "field": "state",          "status": "PASS" },
        { "field": "code_challenge", "status": "FAIL" },
        { "field": "resource",       "status": "SKIP" }
      ]
    }
  },
  {
