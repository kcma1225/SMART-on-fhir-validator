# Prism DB (read-only)
PRISM_DATABASE_URL=postgresql://readonly_user:password@prism-db.internal:5432/prism

# Validator DB password (used by compose.yml to build VALIDATOR_DATABASE_URL)
VALIDATOR_DB_PASSWORD=default_password

# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Backend API port inside the validator container
API_PORT=3000
