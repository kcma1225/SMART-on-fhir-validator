FRONTEND_PORT=80
API_PORT=3000

# Base path / sub-path prefix when this app is served behind an upstream
# path-routing reverse proxy (e.g. nginx `location /validator/`).
# Leave empty to serve at the root. Set WITHOUT a trailing slash, e.g. /validator.
# The upstream proxy must forward the prefix through (do not strip it).
BASE_PATH=

# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Validator DB (internal postgres service)
VALIDATOR_DB_HOST=postgres
VALIDATOR_DB_PORT=5432
VALIDATOR_DB_USER=validator
VALIDATOR_DB_NAME=validator
VALIDATOR_DB_PASSWORD=default_password

# Prism DB (read-only)
PRISM_DATABASE_URL=postgresql://readonly_user:password@prism-db.internal:5432/prism

# Prism web base URL (used for hyperlinks in UI: Connection ID / Share Token links)
BASE_URL=https://twcat-gazelle.dicom.org.tw/prism
