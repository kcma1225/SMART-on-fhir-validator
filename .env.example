# Prism DB (read-only)
PRISM_DATABASE_URL=postgresql://prism:change_me_strong_password@prism-postgres-prism-1:5432/prism

# Admin credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

VALIDATOR_DB_HOST=smart-on-fhir-validator-postgres
VALIDATOR_DB_PORT=5432
VALIDATOR_DB_USER=validator
VALIDATOR_DB_NAME=validator
VALIDATOR_DB_PASSWORD=change_me_strong_password

# Backend API port inside the validator container
API_PORT=3000
FRONTEND_PORT=88
# Base path when served behind a reverse proxy sub-path (e.g. /SMART-on-fhir-validator)
# Leave empty if served at the root (/)
BASE_PATH=/SMART-on-fhir-validator
