generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("VALIDATOR_DATABASE_URL")
}

model ValidationResult {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId  String   @map("connection_id")
  userId        Int?     @map("user_id")
  serverId      String?  @map("server_id")
  serverName    String?  @map("server_name")
  standard      String
  flowStep      String   @map("flow_step")
  fieldLocation String   @map("field_location")
  fieldName     String   @map("field_name")
  required      Boolean
  status        String
  detail        String?
  validatedAt   DateTime @default(now()) @map("validated_at")

  @@index([connectionId])
  @@index([serverId])
  @@index([standard])
  @@index([flowStep])
  @@index([status])
  @@index([validatedAt])
  @@index([serverId, validatedAt])
  @@index([standard, validatedAt])
  @@index([flowStep, validatedAt])
  @@index([status, validatedAt])
  @@map("validation_results")
}

model ProcessedConnection {
  connectionId String   @id @map("connection_id")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@map("processed_connections")
}

model FlowIdentifier {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standard      String
  flowStep      String   @map("flow_step")
  description   String
  method        String
  urlContains   String   @map("url_contains")
  bodyGrantType String?  @map("body_grant_type")
  priority      Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([standard, flowStep])
  @@index([priority])
  @@map("flow_identifiers")
}

model FlowRuleField {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  standard      String
  flowStep      String   @map("flow_step")
  fieldName     String   @map("field_name")
  fieldLocation String   @map("field_location")
  fieldType     String   @map("field_type")
  pattern       String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([standard, flowStep])
  @@index([flowStep])
  @@map("flow_rule_fields")
}

model ValidatorSetting {
  id                         Int       @id
  prismDatabaseUrl           String?   @map("prism_database_url")
  prismDatabaseVerifiedAt    DateTime? @map("prism_database_verified_at")
  prismDatabaseVerifiedUrl   String?   @map("prism_database_verified_url")
  pollingEnabled             Boolean   @default(true) @map("polling_enabled")
  pollingIntervalSeconds     Int       @default(30) @map("polling_interval_seconds")
  pollingBatchSize           Int       @default(100) @map("polling_batch_size")
  baseUrl                    String?   @map("base_url")
  rulesUpdatedAt             DateTime? @map("rules_updated_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("validator_settings")
}
